# Environment Variables for RAG Digital Twin
# Copy this file to .env and fill in your actual API keys

# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Hugging Face API Configuration
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Pinecone durable vector storage (required for persistent Vercel runtime ingestion)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_HOST=https://your-index-host
PINECONE_NAMESPACE=default
RAG_INGEST_TOKEN=your_ingestion_token_here

# Optional: Custom API endpoints
OPENAI_API_BASE=https://api.openai.com/v1
HUGGINGFACE_API_BASE=https://api-inference.huggingface.co

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/rag_system.log

# System Configuration
MAX_WORKERS=4
CACHE_SIZE=1000